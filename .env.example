# Obrigatória quando DJANGO_DEBUG não for o literal "true". Gere com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Padrão é False (seguro). Só o valor "true" (sem distinguir maiúsculas) liga o debug;
# "1" ou "yes" contam como False. Mantenha True apenas em desenvolvimento local
# e NÃO copie esta linha para produção.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Use the same Neon pooled connection string in every production environment.
DATABASE_URL=
DJANGO_MEDIA_ROOT=
CLOUDINARY_URL=
